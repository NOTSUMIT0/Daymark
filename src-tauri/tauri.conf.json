{
  "$schema": "https://schema.tauri.app/config/2.json",
  "productName": "Daymark",
  "version": "1.0.0",
  "identifier": "com.daymark.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Daymark — Daily Work, Clearly Kept",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Turn an overloaded workday into a reliable, private record of progress and next actions.",
    "longDescription": "Daymark is a local-first work ecosystem combining tasks, roadmaps, notes with MS Word style image tools, and focus sprint timers into an executive daily journal.",
    "copyright": "Copyright © 2026 Daymark Systems"
  }
}
